{
  "channels": {
    "telegram": {
      // ============ 基础配置 ============
      "enabled": true,
      "botToken": "你的bot token",

      // ============ 代理配置（可选）============
      // 注意：只支持 HTTP/HTTPS 代理，不支持 socks5://
      "proxy": "http://127.0.0.1:8118",

      // ============ DM 访问控制 ============
      // pairing: 需要配对码（默认，推荐）
      // allowlist: 仅允许白名单用户
      // open: 允许所有人（需要设置 allowFrom: ["*"]）
      // disabled: 禁用私聊
      "dmPolicy": "pairing",

      // DM 白名单（用户 ID 或 @username）
      "allowFrom": [123456789, "@your_username"],

      // ============ 群组配置 ============
      // open: 允许所有群成员发消息
      // allowlist: 仅允许白名单成员（默认）
      // disabled: 禁用群组
      "groupPolicy": "allowlist",

      // 群组成员白名单
      "groupAllowFrom": [123456789, "@admin_user"],

      // 群组详细配置
      "groups": {
        // "*" 表示所有群组的默认配置
        "*": {
          "requireMention": true // 需要@机器人才响应
        },
        // 特定群组配置（群组 ID 是负数）
        "-1001234567890": {
          "requireMention": false, // 不需要@即可响应
          "groupPolicy": "open" // 允许所有群成员
        }
      },

      // ============ 网络配置 ============
      "timeoutSeconds": 500,
      "retry": {
        "attempts": 3,
        "minDelayMs": 1000,
        "maxDelayMs": 5000,
        "jitter": true
      },

      // Node 22+ 网络优化（避免 IPv6 问题）
      "network": {
        "autoSelectFamily": false
      },

      // ============ 消息配置 ============
      "textChunkLimit": 4000,
      "chunkMode": "length",
      "mediaMaxMb": 5,
      "linkPreview": true,

      // ============ 流式输出配置 ============
      "streamMode": "partial", // off | partial | block
      "draftChunk": {
        "minChars": 200,
        "maxChars": 800,
        "breakPreference": "paragraph"
      },

      // ============ 功能开关 ============
      "actions": {
        "reactions": true,
        "sendMessage": true,
        "deleteMessage": true,
        "sticker": false,
        "editMessage": true
      },

      // ============ 反应配置 ============
      "reactionNotifications": "own", // off | own | all
      "reactionLevel": "ack", // off | ack | minimal | extensive

      // ============ 回复线程 ============
      "replyToMode": "first", // off | first | all

      // ============ 自定义命令 ============
      "customCommands": [
        {
          "command": "help",
          "description": "显示帮助信息"
        }
      ]
    }
  }
}
